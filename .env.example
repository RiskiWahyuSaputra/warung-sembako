# Supabase > Project Settings > Data API (URL) dan > API Keys (kunci)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key, diawali sb_publishable_ (dulu disebut "anon key")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, diawali sb_secret_ (dulu "service_role key"). RAHASIA: hanya dipakai server
# untuk konfirmasi pembayaran Midtrans. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Midtrans > Settings > Access Keys (pakai Sandbox dulu)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Client key (Settings > Access Keys), dipakai browser untuk menampilkan halaman QRIS Snap
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# snap (bawaan): QRIS lewat Snap, cukup kanal Snap aktif.
# core: gambar QR langsung lewat Core API, butuh Core API diaktifkan Midtrans untuk akunmu.
MIDTRANS_QRIS_MODE=snap
# Hanya untuk mode core: penyedia QRIS, gopay (bawaan) atau "airpay shopee"
MIDTRANS_QRIS_ACQUIRER=gopay

# Nama yang tampil di aplikasi dan struk
NEXT_PUBLIC_STORE_NAME=Warung Sembako
NEXT_PUBLIC_STORE_ADDRESS=

# Mode demo portofolio (opsional). Bila diisi, halaman login menampilkan tombol "Masuk sebagai Pemilik/Kasir"
# dengan kata sandi ini, yang berarti kata sandinya PUBLIK. Hanya untuk project Supabase demo,
# isi datanya lewat: npm run demo:reset -- --yes
NEXT_PUBLIC_DEMO_PASSWORD=
